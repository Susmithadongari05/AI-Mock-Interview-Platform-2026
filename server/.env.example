# Copy this file to server/.env and fill in YOUR OWN values.
# Never commit .env or share it. This example contains placeholders only.

PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS (comma-separated). In development any
# localhost/127.0.0.1 port is also accepted.
CLIENT_URL=http://localhost:5173

# MongoDB. INCLUDE THE DATABASE NAME after the host (…mongodb.net/ai_mock_interview?…).
# Without it MongoDB silently uses the database called "test".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
# Optional: force the database name regardless of the URI.
MONGODB_DB_NAME=

# Random string, 32+ characters (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# Model ID from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash
# Optional tuning (milliseconds). Defaults are fine for most setups.
# GEMINI_TIMEOUT_MS=30000        one request to Gemini
# GEMINI_DEADLINE_MS=75000       total time including retries
# GEMINI_MAX_ATTEMPTS=4
# AI_ROUTE_TIMEOUT_MS=90000      hard limit for start / code review / feedback requests
# Optional: a second model tried ONLY when the main model stays overloaded (503) or too slow.
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# AssemblyAI (voice answer transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# Murf (optional: reads questions aloud)
MURF_API_KEY=your_murf_api_key
MURF_VOICE_ID=en-US-natalie
